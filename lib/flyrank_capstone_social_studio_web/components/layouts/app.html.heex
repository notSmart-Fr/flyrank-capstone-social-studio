<!-- Navigation Header -->
<header class="border-b border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 sticky top-0 z-50">
  <.container max_width="container" class="py-4">
    <div class="flex items-center justify-between">
      
      <!-- Brand Logo & Live Status -->
      <div class="flex items-center gap-3">
        <.link navigate={~p"/posts"} class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-primary-600 flex items-center justify-center text-white font-bold">
            F
          </div>
          <span class="font-bold text-lg text-gray-900 dark:text-white">Flyrank Social Studio</span>
        </.link>
        <.badge color="success" variant="outline" class="text-xs">
          ● System Online
        </.badge>
      </div>

      <!-- Navigation Links & Theme Switcher -->
      <nav class="flex items-center gap-4">
        <.link navigate={~p"/posts"} class="text-sm font-medium text-gray-600 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400">
          Studio
        </.link>
        <.link navigate={~p"/analytics"} class="text-sm font-medium text-gray-600 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400">
          Analytics
        </.link>

        <!-- Dark Mode Toggle Button -->
        <.button 
          color="gray" 
          variant="outline" 
          size="xs"
          onclick="
            if (document.documentElement.classList.contains('dark')) {
              document.documentElement.classList.remove('dark');
              localStorage.setItem('theme', 'light');
            } else {
              document.documentElement.classList.add('dark');
              localStorage.setItem('theme', 'dark');
            }
          "
        >
          <.icon name="hero-moon-micro" class="dark:hidden w-4 h-4" />
          <.icon name="hero-sun-micro" class="hidden dark:block w-4 h-4" />
        </.button>
      </nav>

    </div>
  </.container>
</header>

<!-- Dynamic LiveView Content Container -->
<main class="min-h-[calc(100vh-140px)] bg-gray-50 dark:bg-gray-950 py-8">
  <.container max_width="container">
    <!-- Flash Messages (LiveView alerts render here) -->
    <.flash_group flash={@flash} />

    <!-- LiveView templates render inside @inner_content -->
    {@inner_content}
  </.container>
</main>

<!-- Footer -->
<footer class="border-t border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 py-6">
  <.container max_width="container" class="flex flex-col sm:flex-row items-center justify-between text-xs text-gray-500 dark:text-gray-400 gap-2">
    <p>© 2026 Flyrank Social Studio. All rights reserved.</p>
    <div class="flex items-center gap-4">
      <span>Built with Elixir & Phoenix LiveView 1.0</span>
    </div>
  </.container>
</footer>