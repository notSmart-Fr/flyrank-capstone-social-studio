<!-- Navigation Header -->
<header class="border-b border-gray-200 dark:border-gray-800 bg-white/95 dark:bg-gray-900 sticky top-0 z-50 backdrop-blur-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <div class="flex items-center justify-between">
      <!-- Brand Logo & Live Status -->
      <div class="flex items-center gap-3">
        <.link navigate={~p"/posts"} class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-primary-600 flex items-center justify-center text-white font-bold">
            F
          </div>

          <span class="font-bold text-lg text-gray-900 dark:text-white">Flyrank Social Studio</span>
        </.link>

        <.badge color="success" variant="outline" class="text-xs">
          ● System Online
        </.badge>
      </div>
      <!-- Navigation Links & Theme Switcher -->
      <nav class="flex items-center gap-4">
        <.link
          navigate={~p"/posts"}
          class="text-sm font-medium text-gray-600 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
        >
          Studio
        </.link>

        <.link
          navigate={~p"/publishing/history"}
          class="text-sm font-medium text-gray-600 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
        >
          Audit Logs
        </.link>

        <.link
          navigate={~p"/analytics"}
          class="text-sm font-medium text-gray-600 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
        >
          Analytics
        </.link>
        <!-- Dark Mode Toggle Button -->
        <button
          id="theme-toggle"
          type="button"
          data-theme-toggle
          aria-label="Toggle dark mode"
          class="inline-flex items-center justify-center rounded-lg border border-gray-200 bg-white p-2 text-gray-700 transition-colors hover:bg-gray-50 dark:border-gray-800 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700"
        >
          <.icon name="hero-moon-micro" class="dark:hidden w-4 h-4" />
          <.icon name="hero-sun-micro" class="hidden dark:block w-4 h-4" />
        </button>
      </nav>
    </div>
  </div>
</header>
<!-- Main App Container with Top/Bottom Margin and Side Padding -->
<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
  <div class="w-full">
    <!-- Floating Toaster Container (Fixed bottom-right so it never pushes the page or causes layout shifts) -->
    <%= if @flash && map_size(@flash) > 0 do %>
      <div
        id="flash-toaster-group"
        class="fixed bottom-5 right-5 z-50 flex flex-col gap-2.5 max-w-md w-full pointer-events-none"
      >
        <%= for {kind, message} <- @flash do %>
          <div
            id={"flash-toast-#{kind}"}
            role="alert"
            class={[
              "pointer-events-auto flex items-start gap-3 p-4 rounded-xl border shadow-xl backdrop-blur-md text-sm transition-all animate-in fade-in slide-in-from-bottom-5 duration-200",
              kind == "info" &&
                "border-blue-200 dark:border-blue-800 bg-white/95 dark:bg-gray-900/95 text-blue-900 dark:text-blue-100 shadow-blue-500/10",
              kind == "error" &&
                "border-red-200 dark:border-red-800 bg-white/95 dark:bg-gray-900/95 text-red-900 dark:text-red-100 shadow-red-500/10",
              kind == "warning" &&
                "border-amber-200 dark:border-amber-800 bg-white/95 dark:bg-gray-900/95 text-amber-900 dark:text-amber-100 shadow-amber-500/10",
              kind == "success" &&
                "border-emerald-200 dark:border-emerald-800 bg-white/95 dark:bg-gray-900/95 text-emerald-900 dark:text-emerald-100 shadow-emerald-500/10"
            ]}
          >
            <!-- Toast Icon -->
            <div class="shrink-0 mt-0.5">
              <%= case kind do %>
                <% "info" -> %>
                  <.icon
                    name="hero-information-circle-micro"
                    class="w-5 h-5 text-blue-600 dark:text-blue-400"
                  />
                <% "error" -> %>
                  <.icon
                    name="hero-exclamation-circle-micro"
                    class="w-5 h-5 text-red-600 dark:text-red-400"
                  />
                <% "warning" -> %>
                  <.icon
                    name="hero-exclamation-triangle-micro"
                    class="w-5 h-5 text-amber-600 dark:text-amber-400"
                  />
                <% "success" -> %>
                  <.icon
                    name="hero-check-circle-micro"
                    class="w-5 h-5 text-emerald-600 dark:text-emerald-400"
                  />
                <% _ -> %>
                  <.icon name="hero-bell-micro" class="w-5 h-5 text-gray-600 dark:text-gray-400" />
              <% end %>
            </div>

            <!-- Toast Body -->
            <div class="flex-1 text-xs font-medium leading-relaxed">
              {message}
            </div>

            <!-- Dismiss Button -->
            <button
              type="button"
              phx-click="lv:clear-flash"
              phx-value-key={kind}
              aria-label="Close notification"
              class="shrink-0 -mr-1 -mt-1 p-1 rounded-lg text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
            >
              <.icon name="hero-x-mark-micro" class="w-4 h-4" />
            </button>
          </div>
        <% end %>
      </div>
    <% end %>

    {@inner_content}
  </div>
</main>
<!-- Footer -->
<footer class="border-t border-gray-200 dark:border-gray-800 bg-white/95 dark:bg-gray-900 py-6 mt-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-500 dark:text-gray-400 gap-2">
    <p>© 2026 Flyrank Social Studio. All rights reserved.</p>

    <div class="flex items-center gap-4">
      <span>Built with Elixir & Phoenix LiveView 1.0</span>
    </div>
  </div>
</footer>
