<div class="space-y-8">
  
  <!-- ================================================================= -->
  <!-- SECTION 1: PAGE HEADER & STATS COUNTER                           -->
  <!-- ================================================================= -->
  <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-200 dark:border-gray-800 pb-5">
    <div>
      <.h2 class="text-gray-900 dark:text-white font-bold text-2xl">Content Ingestion Studio</.h2>
      <.p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
        Ingest Markdown or URLs to generate grounded, platform-tailored social posts.
      </.p>
    </div>
    
    <!-- Real-time counter badge -->
    <div class="flex items-center gap-2">
      <.badge color="info" variant="outline" class="border! border-blue-200! bg-blue-50 text-blue-700 dark:bg-blue-950 dark:border-blue-800 dark:text-blue-300">
        {@posts_count} Ingested Posts
      </.badge>
    </div>
  </header>

  <!-- ================================================================= -->
  <!-- SECTION 2: CONTENT INGESTION FORM CARD                            -->
  <!-- ================================================================= -->
  <section aria-labelledby="ingest-card-title">
    <.card class="bg-white dark:bg-gray-900 shadow-md border! border-gray-200! dark:border-gray-800! rounded-xl">
      <.card_content heading="Ingest New Content" class="p-6">
        
        <.form 
          :let={f} 
          for={@changeset} 
          id="ingest-form" 
          phx-change="validate" 
          phx-submit="save_post" 
          class="space-y-6"
        >
          
          <!-- Field 1: Post Title -->
          <div>
            <.field_label for={f[:title].id} class="font-medium text-gray-700 dark:text-gray-300">Post Title</.field_label>
            <.text_input 
              form={f} 
              field={:title} 
              placeholder="e.g. Scaling Elixir Services on Render" 
              class="w-full mt-1 rounded-lg border! border-gray-300! dark:border-gray-700! bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-primary-500! focus:border-primary-500!" 
            />
            <.form_field_error field={f[:title]} />
          </div>

          <!-- Field 2 & 3: Source Type Select & Target Platforms -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <.field_label for={f[:source_type].id} class="font-medium text-gray-700 dark:text-gray-300">Source Type</.field_label>
              <.select 
                form={f} 
                field={:source_type} 
                options={[{"Markdown Text", "markdown"}, {"Web URL", "url"}]} 
                class="w-full mt-1 rounded-lg border! border-gray-300! dark:border-gray-700! bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-primary-500! focus:border-primary-500!"
              />
            </div>

            <div>
              <.field_label class="font-medium text-gray-700 dark:text-gray-300">Target Platforms</.field_label>
              <div class="flex gap-6 items-center pt-3">
                <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300 cursor-pointer">
                  <input type="checkbox" name="platforms[]" value="telegram" checked class="rounded border-gray-300 text-primary-600 focus:ring-primary-500" />
                  Telegram
                </label>
                <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300 cursor-pointer">
                  <input type="checkbox" name="platforms[]" value="mock_x" checked class="rounded border-gray-300 text-primary-600 focus:ring-primary-500" />
                  Mock X
                </label>
                <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300 cursor-pointer">
                  <input type="checkbox" name="platforms[]" value="mock_linkedin" checked class="rounded border-gray-300 text-primary-600 focus:ring-primary-500" />
                  Mock LinkedIn
                </label>
              </div>
            </div>
          </div>

          <!-- Field 4: Dynamic Source Content Input -->
          <div>
            <.field_label for={f[:content].id} class="font-medium text-gray-700 dark:text-gray-300">
              <%= if @source_type == "url" do %>
                Target Web URL
              <% else %>
                Markdown Source Content
              <% end %>
            </.field_label>

            <%= if @source_type == "url" do %>
              <.text_input 
                form={f} 
                field={:content} 
                placeholder="https://example.com/blog/scaling-elixir" 
                class="w-full mt-1 rounded-lg border! border-gray-300! dark:border-gray-700! bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-primary-500! focus:border-primary-500!"
              />
            <% else %>
              <.textarea 
                form={f} 
                field={:content} 
                rows={5} 
                placeholder="Paste raw Markdown text or article draft here..." 
                class="w-full mt-1 rounded-lg border! border-gray-300! dark:border-gray-700! bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-primary-500! focus:border-primary-500!"
              />
            <% end %>
            <.form_field_error field={f[:content]} />
          </div>

          <!-- Submit Button -->
          <div class="flex justify-end pt-2">
            <.button color="primary" variant="solid" type="submit" loading={@loading} class="shadow-sm px-5 py-2.5">
              <.icon name="hero-sparkles-micro" class="w-4 h-4 mr-2" />
              Ingest & Generate Variants
            </.button>
          </div>

        </.form>
      </.card_content>
    </.card>
  </section>

  <!-- ================================================================= -->
  <!-- SECTION 3: RECENT INGESTIONS GRID / EMPTY STATE                   -->
  <!-- ================================================================= -->
  <section aria-labelledby="recent-ingestions-title" class="space-y-4">
    <.h3 id="recent-ingestions-title" class="text-gray-900 dark:text-white font-bold text-xl">
      Recent Ingestions
    </.h3>

    <%= if @posts_count == 0 do %>
      <!-- Empty State View -->
      <.card class="p-8 text-center text-gray-500 dark:text-gray-400 bg-white dark:bg-gray-900 border-2! border-dashed! border-gray-300! dark:border-gray-800! rounded-xl">
        <.icon name="hero-document-text-micro" class="w-10 h-10 mx-auto mb-2 text-gray-400" />
        <p class="font-medium">No posts ingested yet.</p>
        <p class="text-xs mt-1">Submit content using the form above to start generating social media variants.</p>
      </.card>
    <% else %>
      <!-- Ingested Posts Stream Grid -->
      <div id="posts" phx-update="stream" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <article :for={{dom_id, post} <- @streams.posts} id={dom_id}>
          <.card class="bg-white dark:bg-gray-900 border! border-gray-200! dark:border-gray-800! rounded-xl shadow-sm hover:shadow-md transition-shadow h-full flex flex-col justify-between">
            <.card_content class="p-5">
              <!-- Post Title & Type Badge -->
              <div class="flex items-start justify-between gap-2 mb-2">
                <.h4 class="text-base font-semibold text-gray-900 dark:text-white line-clamp-1">{post.title}</.h4>
                <.badge color="info" variant="outline" label={post.source_type} class="border! border-blue-200! bg-blue-50 text-blue-700 text-xs px-2 py-0.5" />
              </div>
              
              <!-- Post Preview Copy -->
              <p class="text-xs text-gray-600 dark:text-gray-400 line-clamp-3 mb-4">
                {post.content}
              </p>

              <!-- Post Metadata Footer -->
              <footer class="flex items-center justify-between pt-3 border-t border-gray-100 dark:border-gray-800 text-xs text-gray-400">
                <span>Hash: {String.slice(post.content_hash || "n/a", 0, 8)}</span>
                <.link navigate={~p"/posts/#{post.id}"} class="text-primary-600 dark:text-primary-400 font-medium hover:underline flex items-center gap-1">
                  Inspect Variants →
                </.link>
              </footer>
            </.card_content>
          </.card>
        </article>
      </div>
    <% end %>
  </section>

</div>