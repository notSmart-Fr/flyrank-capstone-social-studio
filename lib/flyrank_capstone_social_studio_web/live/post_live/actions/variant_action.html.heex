<.card class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800">
  <.card_content class="p-5 space-y-4">
    <div class="flex border-b border-gray-200 dark:border-gray-800 gap-4">
      <%= for {label, key} <- [{"Telegram", "telegram"}, {"X / Twitter", "mock_x"}, {"LinkedIn", "mock_linkedin"}] do %>
        <button
          type="button"
          phx-click="select_tab"
          phx-value-tab={key}
          class={[
            "py-2 px-1 border-b-2 text-sm font-medium transition-colors flex items-center gap-2 cursor-pointer",
            if(@active_tab == key or (@active_tab == "x" and key == "mock_x"),
              do: "border-primary-600 text-primary-600 dark:text-primary-400",
              else: "border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400"
            )
          ]}
        >
          {label}
        </button>
      <% end %>
    </div>

    <%= if @current_variant do %>
      <div class="space-y-4 pt-1">
        <div class="flex items-center justify-between pb-2 border-b border-gray-100 dark:border-gray-800">
          <div class="flex items-center gap-2">
            <.badge
              color={
                if (@current_variant.model_used || "Local Constraint Template") ==
                     "Local Constraint Template", do: "gray", else: "success"
              }
              variant="soft"
              class="text-xs"
            >
              {if (@current_variant.model_used || "Local Constraint Template") ==
                    "Local Constraint Template",
                  do: "Rule-Based Template",
                  else: "Grounded AI Draft"}
            </.badge>

            <span class="text-xs text-gray-400">
              Model: {@current_variant.model_used || "Local Constraint Template"}
            </span>

            <.badge
              color={
                case @current_variant.status do
                  "published" -> "success"
                  "approved" -> "info"
                  "rejected" -> "danger"
                  _ -> "gray"
                end
              }
              variant="soft"
              class="text-xs"
            >
              {String.capitalize(@current_variant.status || "draft")}
            </.badge>
          </div>

          <%= if @generating do %>
            <div class="inline-flex items-center gap-2 px-3 py-1.5 text-xs font-semibold text-primary-700 bg-primary-50 dark:bg-primary-950/50 rounded-lg border border-primary-200 dark:border-primary-800 animate-pulse">
              <.icon name="hero-arrow-path-micro" class="w-4 h-4 animate-spin text-primary-600" />
              <span>Generating AI Variants...</span>
            </div>
          <% else %>
            <.button
              type="button"
              phx-click="generate_platform_variant"
              phx-value-platform={@active_tab}
              color="primary"
              variant="outline"
              size="xs"
            >
              <.icon name="hero-sparkles-micro" class="w-4 h-4 mr-1" /> {if @canonical_selected,
                do: "Regenerate with AI",
                else: "Generate with AI"}
            </.button>
          <% end %>
        </div>

        <form phx-submit="save_variant" class="space-y-3">
          <input type="hidden" name="variant_id" value={Map.get(@current_variant, :id)} />
          <div class="relative">
            <textarea
              id="variant-edit-textarea"
              name="content"
              rows="8"
              class="w-full p-4 rounded-lg bg-gray-50 dark:bg-gray-950 border border-gray-200 dark:border-gray-800 text-sm text-gray-800 dark:text-gray-200 leading-relaxed focus:ring-primary-500 focus:border-primary-500"
            >{@current_variant.content}</textarea>
            <button
              type="button"
              onclick="navigator.clipboard.writeText(document.getElementById('variant-edit-textarea').value)"
              class="absolute top-3 right-3 px-2 py-1 text-xs bg-white dark:bg-gray-800 text-gray-600 dark:text-gray-300 rounded border border-gray-200 dark:border-gray-700 hover:bg-gray-50 flex items-center gap-1 shadow-sm"
            >
              <.icon name="hero-clipboard-document-micro" class="w-3.5 h-3.5" /> Copy
            </button>
          </div>

          <div class="flex items-center justify-between pt-2 border-t border-gray-100 dark:border-gray-800">
            <div class="flex gap-2">
              <.button
                type="submit"
                color="gray"
                variant="outline"
                size="xs"
                class="cursor-pointer"
              >
                <.icon name="hero-check-micro" class="w-4 h-4 mr-1" /> Save Edits
              </.button>

              <%= if Map.get(@current_variant, :id) do %>
                <button
                  type="button"
                  phx-click="reject_variant"
                  phx-value-id={@current_variant.id}
                  class="text-xs font-medium text-red-600 hover:underline cursor-pointer"
                >
                  Reject
                </button>
              <% end %>
            </div>

            <%= if Map.get(@current_variant, :id) do %>
              <FlyrankCapstoneSocialStudioWeb.PostLive.Actions.PublishAction.publish_action
                variant={@current_variant}
                active_tab={@active_tab}
                show_schedule_modal={@show_schedule_modal}
              />
            <% else %>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium text-amber-700 bg-amber-50 border border-amber-200 rounded-md">
                <.icon name="hero-sparkles-micro" class="w-3.5 h-3.5 text-amber-500" />
                Unsaved Draft — Save Edits first
              </span>
            <% end %>
          </div>
        </form>
      </div>
    <% else %>
      <div class="p-8 text-center text-gray-500 dark:text-gray-400 bg-gray-50 dark:bg-gray-950 rounded-lg border border-dashed border-gray-200 dark:border-gray-800 space-y-3">
        <p class="text-sm font-medium">No variant generated for {@active_tab} yet.</p>

        <.button
          type="button"
          phx-click="generate_platform_variant"
          phx-value-platform={@active_tab}
          color="primary"
          variant="outline"
          size="xs"
        >
          <.icon name="hero-sparkles-micro" class="w-4 h-4 mr-1" /> Generate with Gemini
        </.button>
      </div>
    <% end %>
  </.card_content>
</.card>
